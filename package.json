{
  "name": "happier-ui",
  "version": "0.0.10",
  "type": "module",
  "description": "Web 与移动端通用的 Vue 语义 UI；Tailwind v4 + --h-* token / h- utility",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/Happier-X/happier-ui.git"
  },
  "homepage": "https://happier-x.github.io/happier-ui/",
  "bugs": {
    "url": "https://github.com/Happier-X/happier-ui/issues"
  },
  "keywords": [
    "vue",
    "vue3",
    "ui",
    "components",
    "tailwindcss",
    "web",
    "mobile",
    "design-tokens"
  ],
  "engines": {
    "node": ">=18"
  },
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    },
    "./styles": "./dist/styles.css",
    "./styles.css": "./dist/styles.css",
    "./tokens.css": "./dist/tokens.css",
    "./package.json": "./package.json"
  },
  "files": [
    "dist",
    "LICENSE",
    "README.md"
  ],
  "publishConfig": {
    "access": "public"
  },
  "main": "./dist/index.js",
  "module": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "sideEffects": [
    "**/*.css"
  ],
  "peerDependencies": {
    "@lucide/vue": "^1.25.0",
    "tailwindcss": "^4",
    "vue": "^3.5.0"
  },
  "scripts": {
    "build:lib": "vite build",
    "dev": "npm run dev -w happier-ui-playground",
    "build:playground": "npm run build -w happier-ui-playground",
    "dev:playground": "npm run dev -w happier-ui-playground",
    "docs:dev": "vitepress dev docs",
    "docs:build": "vitepress build docs",
    "docs:preview": "vitepress preview docs"
  },
  "workspaces": [
    "playground"
  ],
  "devDependencies": {
    "@lucide/vue": "^1.28.0",
    "@tailwindcss/vite": "^4.3.3",
    "@vitejs/plugin-vue": "^6.0.8",
    "esbuild": "^0.28.1",
    "search-insights": "^2.17.3",
    "tailwindcss": "^4.3.3",
    "typescript": "^5.9.3",
    "vite": "^8.2.0",
    "vite-plugin-dts": "^5.0.3",
    "vitepress": "^1.6.4",
    "vue": "^3.5.40",
    "vue-tsc": "^3.3.9"
  },
  "dependencies": {
    "dayjs": "^1.11.21"
  }
}
